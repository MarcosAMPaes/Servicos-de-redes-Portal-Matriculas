# ──────────────────────────────────────────────────────────────────
# Portal de Matrículas — Variáveis de Ambiente (exemplo)
#
# Copie este arquivo para .env e preencha os valores reais.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────

PROJECT_NAME=Portal de Matriculas

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_DB=portal_matriculas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=MATRICULA_DE_UM_INTEGRANTE
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://postgres:MATRICULA_DE_UM_INTEGRANTE@postgres:5432/portal_matriculas

# ── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=GERAR_UMA_STRING_ALEATORIA_LONGA_AQUI
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=120

# ── Backend ─────────────────────────────────────────────────────────
BACKEND_HOST=fastapi
BACKEND_PORT=8080
