# Variáveis de ambiente — nunca versionar (contém senha do banco e JWT secret)
.env

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Node/Vite
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Certificados TLS (gerados localmente, não versionados)
nginx/certs/*.crt
nginx/certs/*.key

# Editor
.vscode/
.idea/
.claude/

# Vagrant/local VM state
.vagrant/
.vagrant-swarm/

# OS
.DS_Store
Thumbs.db
